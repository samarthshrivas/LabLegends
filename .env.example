# ---------------------------------------------------------------------------
# LabLegends environment template. Copy to `.env.local` and fill in locally.
# NEVER commit real credentials. The app runs fully in demo mode with no
# environment variables set, using synthetic data only.
# ---------------------------------------------------------------------------

# Public site URL used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode keeps all learner data in the browser (localStorage).
# Set to "false" only when a real persistence backend is configured below.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (optional foundation — the UI still runs in demo mode) --------
# Use the publishable key in the browser. Never expose a secret/service-role key.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy fallback only: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the client
